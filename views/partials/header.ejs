<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title || "Campus Q&A" %></title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">Campus Q&amp;A</a>
        <nav class="nav" aria-label="Account">
          <a class="nav-link" href="/boards">Boards</a>
          <% if (currentUser) { %>
            <a class="nav-link" href="/rooms">Rooms</a>
            <a class="nav-link" href="/questions/new">Ask a question</a>
            <span class="signed-in">Signed in as <strong><%= currentUser.uName %></strong></span>
            <form method="POST" action="/logout" class="inline-form">
              <button class="button button-small button-secondary" type="submit">Log out</button>
            </form>
          <% } else { %>
            <a class="nav-link" href="/login">Log in</a>
            <a class="button button-small" href="/register">Register</a>
          <% } %>
        </nav>
      </div>
    </header>